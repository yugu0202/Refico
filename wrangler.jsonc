{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "refico",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "preview_urls": true,
  "vars": {
    "DB_BACKEND": "turso",
    "TURSO_DATABASE_URL": "libsql://refico-production-yugu0202.aws-ap-northeast-1.turso.io",
    "APP_ENV": "production",
    "AUTH_MODE": "google",
    "BETTER_AUTH_URL": "https://refico.yugu0202.net",
  },
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "previews": {
    "vars": {
      "DB_BACKEND": "turso",
      "TURSO_DATABASE_URL": "libsql://refico-preview-yugu0202.aws-ap-northeast-1.turso.io",
      "APP_ENV": "preview",
      "AUTH_MODE": "test",
    },
    "d1_databases": [],
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "head_sampling_rate": 1,
        "persist": true,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true,
      },
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
